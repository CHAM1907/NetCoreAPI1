@model List<BaiThucHanhSo3.Models.Student>

<h2 class="mb-4">Danh sách sinh viên</h2>

<a href="/Student/Create" class="btn btn-success mb-3">
    + Thêm sinh viên
</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Hành động</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.StudentCode</td>
                <td>@item.FullName</td>
                <td>
                    <a href="/Student/Edit/@item.Id" class="btn btn-warning btn-sm">
                        Sửa
                    </a>
                    <a href="/Student/Delete/@item.Id" class="btn btn-danger btn-sm">
                        Xoá
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>