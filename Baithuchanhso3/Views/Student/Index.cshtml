@model List<BaiThucHanhSo3.ViewModels.StudentFacultyVM>

<h2 class="mb-4">Danh sách sinh viên</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a href="/Student/Create" class="btn btn-success mb-3">
    + Thêm sinh viên
</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Tuổi</th>
            <th>Email</th>
            <th>Khoa</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentCode</td>
                <td>@item.FullName</td>
                <td>@item.Age</td>
                <td>@item.Email</td>
                <td>
                    <span class="badge bg-primary">@item.FacultyName</span>
                </td>
                <td>
                    <a href="/Student/Edit/@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a href="/Student/Delete/@item.Id" class="btn btn-danger btn-sm">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
