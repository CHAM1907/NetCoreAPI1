@model BaiThucHanhSo3.Models.Student

<h2>Thêm sinh viên</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="StudentCode"></label>
        <input asp-for="StudentCode" class="form-control" placeholder="Nhập mã sinh viên" />
        <span asp-validation-for="StudentCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" placeholder="Nhập tuổi" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" placeholder="Nhập email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Lưu</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}