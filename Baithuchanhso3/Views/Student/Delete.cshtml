@model BaiThucHanhSo3.Models.Student

<h2 class="mb-4 text-danger">Xác nhận xóa sinh viên</h2>

<div class="card col-md-5">
    <div class="card-body">
        <p><strong>Mã SV:</strong> @Model.StudentCode</p>
        <p><strong>Họ tên:</strong> @Model.FullName</p>
        <p><strong>Khoa:</strong> @(Model.Faculty?.FacultyName ?? "Chưa phân khoa")</p>
        <p class="text-danger">Bạn có chắc chắn muốn xóa sinh viên này không?</p>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
        </form>
    </div>
</div>
